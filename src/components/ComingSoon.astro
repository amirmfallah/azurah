---
import { siteConfig } from "../data/config";
---

<div class="min-h-screen flex items-center justify-center px-8 py-12">
  <div class="w-full max-w-4xl">
    <!-- Logo -->
    <div class="flex justify-center mb-12 md:mb-16">
      <img src="/logo.png" alt="Azurah Frequency" class="w-auto h-24 md:h-32 object-contain" />
    </div>

    <!-- Coming Soon Message -->
    <div class="text-center mb-12 md:mb-16">
      <h1 class="hero-text mb-6 md:mb-8">Coming Soon</h1>
      <p class="text-lg md:text-xl tracking-wide max-w-xl mx-auto">
        {siteConfig.siteName} is launching soon. Sign up to get notified when we go live.
      </p>
    </div>

    <!-- Newsletter Form -->
    <div class="max-w-2xl mx-auto">
      <form class="space-y-6">
        <!-- Email -->
        <div>
          <label for="email" class="text-xs tracking-widest opacity-70 block mb-3">Email Address *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full bg-transparent border-b border-white border-opacity-50 focus:border-opacity-100 outline-none py-2 text-base md:text-lg transition-all"
            placeholder=""
          />
        </div>

        <!-- Name -->
        <div>
          <label for="name" class="text-xs tracking-widest opacity-70 block mb-3">First Name</label>
          <input
            type="text"
            id="name"
            name="name"
            class="w-full bg-transparent border-b border-white border-opacity-50 focus:border-opacity-100 outline-none py-2 text-base md:text-lg transition-all"
            placeholder=""
          />
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button
            type="submit"
            class="w-full border border-white py-4 px-8 text-xs tracking-widest hover:bg-white hover:text-black transition-colors duration-300 uppercase hover:cursor-pointer"
          >
            Notify Me
          </button>
        </div>
      </form>
    </div>

    <!-- Social Links (Optional) -->
    <div class="mt-16 md:mt-20 text-center">
      <p class="text-xs tracking-widest opacity-50 mb-6">Follow Us</p>
      <div class="flex justify-center gap-6 md:gap-8">
        {
          siteConfig.socialLinks.map((link) =>
            link.url ? (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs tracking-widest hover:underline opacity-60 hover:opacity-100 transition-opacity"
              >
                {link.name}
              </a>
            ) : (
              <span class="text-xs tracking-widest opacity-30 cursor-not-allowed">{link.name}</span>
            )
          )
        }
      </div>
    </div>
  </div>
</div>
